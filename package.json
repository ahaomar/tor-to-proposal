{
  "name": "tor-to-proposal",
  "version": "2.1.6",
  "description": "The bid tool that refuses to lie. ToR + CV in -> verified bid pack out: cover letter, tailored CV, technical response, financial proposal, submission checklist. Deterministic CLI + agent skill for UN / NGO / government consultants.",
  "type": "module",
  "bin": {
    "tor-to-proposal": "bin/tor-to-proposal.mjs"
  },
  "files": [
    "bin/",
    "mcp/",
    "commands/",
    "assets/",
    "references/",
    "library/",
    "docs/",
    "SKILL.md",
    "README.md",
    "LICENSE",
    ".claude-plugin/"
  ],
  "scripts": {
    "test": "node test/run-tests.mjs",
    "postinstall": "node -e \"console.log('tor-to-proposal installed. Run: tor-to-proposal init (one-time profile wizard).')\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "exceljs": "^4.4.0",
    "mammoth": "^1.8.0",
    "unpdf": "^1.8.1"
  },
  "keywords": [
    "tor",
    "proposal",
    "un",
    "ungm",
    "undp",
    "consultant",
    "tender",
    "bid",
    "rfp",
    "cover-letter",
    "financial-proposal",
    "cv",
    "agent-skills",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahaomar/tor-to-proposal.git"
  },
  "homepage": "https://github.com/ahaomar/tor-to-proposal#readme",
  "license": "MIT"
}
